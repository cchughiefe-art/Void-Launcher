<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="104dp" android:gravity="center"
    android:orientation="vertical" android:padding="5dp">
    <ImageView android:id="@+id/icon" android:layout_width="54dp" android:layout_height="54dp"
        android:contentDescription="@null" />
    <TextView android:id="@+id/label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:ellipsize="end" android:gravity="center" android:maxLines="1"
        android:textColor="@color/void_white" android:textSize="12sp" />
</LinearLayout>
